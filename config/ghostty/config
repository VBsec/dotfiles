theme = dark:ayu_dark,light:ayu_light
# background-opacity = 0.92
unfocused-split-opacity = 0.95
macos-titlebar-style = hidden
# font-family = "MesloLGS Nerd Font Mono"
font-thicken = true
font-size = 14
window-padding-x = 5
window-padding-y = 5
# Set to false to let macOS handle Option key for compose/input methods
macos-option-as-alt = false

# Pass Ctrl+Tab to terminal apps (zellij tab switching)
keybind = ctrl+tab=esc:[27;5;9~
keybind = ctrl+shift+tab=esc:[27;6;9~

# Pass Cmd+1..9 through to herdr (focus agent) instead of Ghostty goto_tab
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
# Defaults also bind the physical keys (super+digit_N), so unbind those too
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind

# keybind = ctrl+k=goto_split:up
# keybind = ctrl+j=goto_split:down
# keybind = ctrl+l=goto_split:right
# keybind = ctrl+h=goto_split:left
keybind = super+left_bracket=goto_split:previous
keybind = super+right_bracket=goto_split:next

keybind = super+ctrl+n=equalize_splits

# keybind = super+ctrl+k=resize_split:up,15
# keybind = super+ctrl+j=resize_split:down,15
# keybind = super+ctrl+l=resize_split:right,15
# keybind = super+ctrl+h=resize_split:left,15

# keybind = super+j=new_split:down
# keybind = super+l=new_split:right
keybind = super+w=close_surface

keybind = super+up=scroll_to_top
keybind = super+down=scroll_to_bottom
keybind = super+page_up=scroll_page_up
keybind = super+page_down=scroll_page_down

# keybind = global:=toggle_quick_terminal

# custom-shader = shaders/just-snow.glsl
# custom-shader = shaders-fearless/static.glsl


# Shift+Enter sends same escape sequence as Option+Enter for Claude Code multiline input
keybind = shift+enter=text:\x1b\r

# Pass Ctrl+Cmd+j/k to terminal for Neovim line moving
keybind = ctrl+super+j=unbind
keybind = ctrl+super+k=unbind
